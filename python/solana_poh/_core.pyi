from collections.abc import Sequence

class PohEntry:
    def __init__(self, num_hashes: int, hash: bytes, mixin: bytes | None = None) -> None: ...
    @property
    def num_hashes(self) -> int: ...
    @property
    def hash(self) -> bytes: ...
    @property
    def mixin(self) -> bytes | None: ...
    @property
    def is_tick(self) -> bool: ...

class Poh:
    def __init__(self, start_hash: bytes, hashes_per_tick: int | None = None) -> None: ...
    def hash(self, max_num_hashes: int) -> bool: ...
    def record(self, mixin: bytes) -> PohEntry | None: ...
    def tick(self) -> PohEntry | None: ...
    def remaining_hashes_in_slot(self, ticks_per_slot: int) -> int: ...
    @property
    def current_hash(self) -> bytes: ...
    @property
    def num_hashes(self) -> int: ...
    @property
    def hashes_per_tick(self) -> int | None: ...
    @property
    def remaining_hashes_until_tick(self) -> int: ...
    @property
    def tick_number(self) -> int: ...

def verify(start_hash: bytes, entries: Sequence[PohEntry]) -> None: ...
def verify_parallel(start_hash: bytes, entries: Sequence[PohEntry]) -> None: ...
def verify_tick_hash_counts(entries: Sequence[PohEntry], hashes_per_tick: int) -> None: ...
def hash_signatures(signatures: Sequence[bytes]) -> bytes: ...
